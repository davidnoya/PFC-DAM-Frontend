<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#EBEBEB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/referenciaSolicitud"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Referencia"
                android:textColor="@color/principal"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/estadoSolicitud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN PROCESO"
                android:textColor="#F39C12"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#FEF5E7"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"/>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IBAN Origen:"
            android:textColor="#7F8C8D"
            android:textSize="12sp"
            android:layout_marginTop="12dp"/>

        <TextView
            android:id="@+id/ibanOrigen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESXX XXXX XXXX XXXX 1234"
            android:textColor="@color/principal"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/fechaSolicitud"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Solicitado el: XX/XX/XXXX"
            android:textColor="#7F8C8D"
            android:textSize="12sp"
            android:gravity="end"
            android:layout_marginTop="8dp"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>