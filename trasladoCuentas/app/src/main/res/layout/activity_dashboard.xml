<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarTraslados"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:paddingTop="16dp"
        android:background="@drawable/cabecera"
        android:elevation="8dp"
        app:title="Tus Traslados"
        app:titleCentered="true"
        app:titleTextColor="#000000"
        app:titleTextAppearance="@style/negrita" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/mensajeVacio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aún no has solicitado ningún traslado de cuenta."
                android:textAlignment="center"
                android:textColor="#7F8C8D"
                android:textSize="16sp"
                android:layout_marginTop="40dp"
                android:visibility="gone"/> <LinearLayout
            android:id="@+id/contenedorSolicitudes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>