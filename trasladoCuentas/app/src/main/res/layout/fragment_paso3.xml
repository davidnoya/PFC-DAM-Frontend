<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F9FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Paso 3: Peticiones"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/principal"
                android:textAlignment="center"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Seleccione las acciones que debemos solicitar a su entidad de origen."
                android:textSize="15sp"
                android:textColor="@color/secundario"
                android:textAlignment="center"
                android:layout_marginBottom="32dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="16dp"
                android:elevation="2dp">

                <CheckBox
                    android:id="@+id/chkCancelar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancelar órdenes de transferencia"
                    android:layout_marginBottom="12dp"
                    android:buttonTint="@color/principal"/>

                <CheckBox
                    android:id="@+id/chkBloquear"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bloquear transferencias entrantes"
                    android:layout_marginBottom="12dp"
                    android:buttonTint="@color/principal"/>

                <CheckBox
                    android:id="@+id/chkTransferirCierre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Transferir saldo restante y cerrar cuenta"
                    android:layout_marginBottom="12dp"
                    android:buttonTint="@color/principal"/>

                <CheckBox
                    android:id="@+id/chkRecibirInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Recibir información de operaciones"
                    android:buttonTint="@color/principal"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSiguiente3"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:text="SIGUIENTE"
        app:backgroundTint="@color/principal"
        android:textColor="@android:color/white" />

</LinearLayout>